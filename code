# 9. ATTENDANCE FUNCTION
# ------------------------------------------------------------

def mark_attendance(student):

    today = datetime.now().strftime(
        "%Y-%m-%d"
    )

    current_time = datetime.now().strftime(
        "%H:%M:%S"
    )

    already_present = False


    # Check existing attendance
    try:

        with open(
            ATTENDANCE_FILE,
            "r",
            newline="",
            encoding="utf-8"
        ) as f:

            reader = csv.DictReader(f)

            for row in reader:

                if (
                    row.get("Student ID")
                    == student["student_id"]
                    and
                    row.get("Date")
                    == today
                ):

                    already_present = True

                    break

    except FileNotFoundError:

        pass


    # Add attendance
    if not already_present:

        with open(
            ATTENDANCE_FILE,
            "a",
            newline="",
            encoding="utf-8"
        ) as f:

            writer = csv.writer(f)

            writer.writerow([

                student["name"],

                student["student_id"],

                student["department"],

                today,

                current_time,

                "Present"
            ])

        print(
            "\n✅ Attendance marked:",
            student["name"]
        )

    else:

        print(
            "\nℹ️ Attendance already marked today:",
            student["name"]
        )


