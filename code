# 10. GOOGLE COLAB CAMERA FUNCTION
# ------------------------------------------------------------

def take_photo():

    print("\n📷 Starting browser camera...")
    print(
        "If Chrome asks for permission, click ALLOW."
    )


    js = Javascript("""
    async function takePhoto() {

        try {

            // Check camera API
            if (
                !navigator.mediaDevices ||
                !navigator.mediaDevices.getUserMedia
            ) {

                return "ERROR_BROWSER";
            }


            // Request camera
            const stream =
                await navigator.mediaDevices.getUserMedia({

                    video: {
                        facingMode: "user"
                    },

                    audio: false

                });


            // Create video
            const video =
                document.createElement("video");


            video.style.width = "640px";

            video.style.maxWidth = "100%";

            video.style.display = "block";


            document.body.appendChild(
                video
            );


            video.srcObject =
                stream;


            await video.play();


            // Wait for camera
            await new Promise(
                resolve =>
                    setTimeout(
                        resolve,
                        1500
                    )
            );


            // Create canvas
            const canvas =
                document.createElement(
                    "canvas"
                );


            canvas.width =
                video.videoWidth;

            canvas.height =
                video.videoHeight;


            // Capture image
            canvas
                .getContext("2d")
                .drawImage(
                    video,
                    0,
                    0
                );


            // Stop camera
            stream
                .getTracks()
                .forEach(
                    track =>
                        track.stop()
                );


            video.remove();


            return canvas.toDataURL(
                "image/jpeg"
            );

        }


        catch(error) {

            console.log(
                "Camera error:",
                error.name
            );


            if (
                error.name ===
                "NotAllowedError"
            ) {

                return "ERROR_PERMISSION";
            }


            if (
                error.name ===
                "PermissionDeniedError"
            ) {

                return "ERROR_PERMISSION";
            }


            if (
                error.name ===
                "NotFoundError"
            ) {

                return "ERROR_NO_CAMERA";
            }


            if (
                error.name ===
                "DevicesNotFoundError"
            ) {

                return "ERROR_NO_CAMERA";
            }


            if (
                error.name ===
                "NotReadableError"
            ) {

                return "ERROR_CAMERA_BUSY";
            }


            if (
                error.name ===
                "TrackStartError"
            ) {

                return "ERROR_CAMERA_BUSY";
            }


            if (
                error.name ===
                "SecurityError"
            ) {

                return "ERROR_SECURITY";
            }


            return "ERROR_UNKNOWN";
        }
    }


    takePhoto();

    """)


    display(js)


    # --------------------------------------------------------
    # ASK BROWSER
    # --------------------------------------------------------

    try:

        data = eval_js(
            "takePhoto()"
        )

    except Exception as e:

        error_text = str(e)

        print("\n❌ CAMERA REQUEST FAILED")

        print(
            "Error:",
            error_text
        )

        print("\nPossible solutions:")

        print(
            "1. Allow camera permission."
        )

        print(
            "2. Refresh the Colab page."
        )

        print(
            "3. Make sure another app is not using camera."
        )

        return None


    # --------------------------------------------------------
    # HANDLE PERMISSION ERROR
    # --------------------------------------------------------

    if data == "ERROR_PERMISSION":

        print("\n" + "=" * 65)

        print(
            "❌ CAMERA PERMISSION DENIED"
        )

        print("=" * 65)

        print("""
Please do this:

1. Browser address bar ke camera icon par click karein.
2. Camera = Allow karein.
3. Google Colab page refresh karein.
4. Cell dobara run karein.
5. Camera permission aaye to Allow karein.
""")

        return None


    # --------------------------------------------------------
    # NO CAMERA
    # --------------------------------------------------------

    if data == "ERROR_NO_CAMERA":

        print("\n❌ CAMERA NOT FOUND")

        print("""
Please check:

• Laptop/PC camera available hai.
• Camera kisi aur application mein use nahi ho raha.
• Browser ko camera access allowed hai.
""")

        return None


    # --------------------------------------------------------
    # CAMERA BUSY
    # --------------------------------------------------------

    if data == "ERROR_CAMERA_BUSY":

        print("\n❌ CAMERA IS BUSY")

        print("""
Camera kisi doosri application ne use kiya hua hai.

Close:
• Zoom
• Microsoft Teams
• Google Meet
• Windows Camera
• Other webcam applications

Then try again.
""")

        return None


    # --------------------------------------------------------
    # BROWSER ERROR
    # --------------------------------------------------------

    if data == "ERROR_BROWSER":

        print("\n❌ BROWSER CAMERA API NOT AVAILABLE")

        print("""
Use an updated version of:

• Google Chrome
• Microsoft Edge

Then refresh Google Colab.
""")

        return None


    # --------------------------------------------------------
    # SECURITY ERROR
    # --------------------------------------------------------

    if data == "ERROR_SECURITY":

        print("\n❌ CAMERA SECURITY ERROR")

        print("""
Browser has blocked camera access.

Make sure you are using Google Colab
through HTTPS and camera permission is allowed.
""")

        return None


    # --------------------------------------------------------
    # UNKNOWN ERROR
    # --------------------------------------------------------

    if data == "ERROR_UNKNOWN":

        print("\n❌ UNKNOWN CAMERA ERROR")

        print(
            "Camera image could not be captured."
        )

        return None


    # --------------------------------------------------------
    # CONVERT BASE64 TO IMAGE
    # --------------------------------------------------------

    try:

        binary = b64decode(
            data.split(",")[1]
        )


        image = np.frombuffer(
            binary,
            dtype=np.uint8
        )


        frame = cv2.imdecode(
            image,
            cv2.IMREAD_COLOR
        )


        if frame is None:

            print(
                "\n❌ Camera image could not be decoded."
            )

            return None


        print(
            "\n✅ Camera image captured successfully!"
        )


        return frame


    except Exception as e:

        print(
            "\n❌ IMAGE PROCESSING ERROR"
        )

        print(
            e
        )

        return None


# ------------------------------------------------------------
# 11. START CAMERA
# ------------------------------------------------------------

print("\n" + "=" * 65)

print(
    "CAMERA / FACE RECOGNITION"
)

print("=" * 65)


frame = take_photo()


# ------------------------------------------------------------
# 12. STOP IF CAMERA FAILED
# ------------------------------------------------------------

if frame is None:

    print("\nSystem stopped safely.")

    print(
        "Fix camera permission and run the cell again."
    )


else:

    # --------------------------------------------------------
    # FACE DETECTION
    # --------------------------------------------------------

    rgb_frame = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2RGB
    )


    face_locations = (
        face_recognition.face_locations(
            rgb_frame
        )
    )


    face_encodings = (
        face_recognition.face_encodings(
            rgb_frame,
            face_locations
        )
    )


    print(
        "\nFaces detected:",
        len(face_locations)
    )


    # --------------------------------------------------------
    # PROCESS EACH FACE
    # --------------------------------------------------------

    for face_encoding, location in zip(
        face_encodings,
        face_locations
    ):


        # Default
        name_text = "Unknown"

        id_text = "ID: Unknown"

        dept_text = "Department: Unknown"

        status_text = "Not Registered"


        # ----------------------------------------------------
        # FACE MATCH
        # ----------------------------------------------------

        if len(known_encodings) > 0:


            distances = (
                face_recognition.face_distance(
                    known_encodings,
                    face_encoding
                )
            )


            best_index = np.argmin(
                distances
            )


            # Recognition threshold
            if (
                distances[best_index]
                < 0.50
            ):


                student = (
                    known_students[
                        best_index
                    ]
                )


                name_text = (
                    student["name"]
                )


                id_text = (
                    "ID: "
                    + student["student_id"]
                )


                dept_text = (
                    "Department: "
                    + student["department"]
                )


                status_text = (
                    "Registered"
                )


                # Mark attendance
                mark_attendance(
                    student
                )


        # ----------------------------------------------------
        # FACE COORDINATES
        # ----------------------------------------------------

        top, right, bottom, left = (
            location
        )


        # ----------------------------------------------------
        # FACE BOX
        # ----------------------------------------------------

        cv2.rectangle(

            frame,

            (left, top),

            (right, bottom),

            (0, 255, 0),

            3

        )


        # ----------------------------------------------------
        # NAME
        # ----------------------------------------------------

        cv2.putText(

            frame,

            name_text,

            (left, max(30, top - 45)),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.75,

            (0, 255, 0),

            2

        )


        # ----------------------------------------------------
        # STUDENT ID
        # ----------------------------------------------------

        cv2.putText(

            frame,

            id_text,

            (left, bottom + 25),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.60,

            (0, 255, 0),

            2

        )


        # ----------------------------------------------------
        # DEPARTMENT
        # ----------------------------------------------------

        cv2.putText(

            frame,

            dept_text,

            (left, bottom + 50),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.55,

            (0, 255, 0),

            2

        )


        # ----------------------------------------------------
        # STATUS
        # ----------------------------------------------------

        cv2.putText(

            frame,

            status_text,

            (left, bottom + 75),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.55,

            (0, 255, 0),

            2

        )


    # --------------------------------------------------------
    # SHOW RESULT
    # --------------------------------------------------------

    print("\n" + "=" * 65)

    print(
        "CAMERA RESULT"
    )

    print("=" * 65)


    if len(face_locations) == 0:

        print(
            "No face detected."
        )


    cv2_imshow(
        frame
    )


